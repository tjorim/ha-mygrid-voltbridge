{
  "domain": "mygrid_voltbridge",
  "name": "MyGrid VoltBridge",
  "codeowners": ["@tjorim"],
  "config_flow": true,
  "dhcp": [{"registered_devices": true}],
  "documentation": "https://github.com/tjorim/ha-mygrid-voltbridge/blob/main/README.md",
  "integration_type": "device",
  "iot_class": "local_push",
  "issue_tracker": "https://github.com/tjorim/ha-mygrid-voltbridge/issues",
  "loggers": ["mygrid_voltbridge"],
  "requirements": ["mygrid-voltbridge@git+https://github.com/tjorim/mygrid-voltbridge@v0.2.0"],
  "version": "0.1.0",
  "zeroconf": [
    {
      "type": "_mygrid._tcp.local.",
      "properties": {"model": "voltbridge*"}
    }
  ]
}
