{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>tjorim/renovate-config:home-assistant"
  ],
  "packageRules": [
    {
      "description": [
        "Update the runtime manifest and development dependency together."
      ],
      "matchDatasources": [
        "pypi"
      ],
      "matchPackageNames": [
        "mygrid-voltbridge"
      ],
      "groupName": "mygrid-voltbridge"
    }
  ]
}
